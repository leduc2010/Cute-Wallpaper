<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="36dp"
    android:layout_marginStart="12dp"
    android:background="@drawable/bg_home_category_item"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <FrameLayout
        android:id="@+id/iconContainer"
        android:layout_width="36dp"
        android:layout_height="36dp">

        <ImageView
            android:id="@+id/glyphIcon"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_favorites_category_icon"
            android:importantForAccessibility="no"
            android:padding="8dp"
            android:scaleType="centerInside" />

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/artworkIcon"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop"
            android:visibility="gone"
            app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.CollectionIcon"
            app:strokeColor="@color/neutral_0"
            app:strokeWidth="2dp" />
    </FrameLayout>

    <TextView
        android:id="@+id/label"
        style="@style/Body14M"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingStart="4dp"
        android:paddingEnd="12dp"
        android:singleLine="true"
        android:textColor="@color/tertiary_600" />
</LinearLayout>

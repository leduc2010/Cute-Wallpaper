<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/homeHeader"
    android:layout_width="match_parent"
    android:layout_height="64dp"
    android:layout_marginHorizontal="16dp"
    android:layout_marginTop="4dp"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <ImageView
        android:layout_width="66dp"
        android:layout_height="wrap_content"
        android:src="@drawable/img_cutii" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="8dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="11dp"
                android:layout_height="16dp"
                android:layout_marginEnd="4dp"
                android:src="@drawable/ic_home_title_heart" />

            <TextView
                android:id="@+id/tvTitle"
                style="@style/Label12B"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:drawablePadding="4dp"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="@string/wallpapers"
                android:textColor="@color/tertiary_900" />
        </LinearLayout>

        <TextView
            style="@style/Label10R"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="@string/home_tagline"
            android:textColor="@color/tertiary_500" />
    </LinearLayout>

    <ImageView
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:id="@+id/btnVideo"
        android:layout_marginStart="4dp"
        android:src="@drawable/ic_home_play" />

    <ImageView
        android:layout_width="44dp"
        android:id="@+id/btnFilter"
        android:layout_height="44dp"
        android:layout_marginStart="4dp"
        android:elevation="10dp"
        android:src="@drawable/ic_home_filter" />
</LinearLayout>

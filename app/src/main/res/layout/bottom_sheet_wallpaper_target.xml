<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_wallpaper_target_sheet"
    android:paddingStart="22dp"
    android:paddingTop="20dp"
    android:paddingEnd="22dp"
    android:paddingBottom="24dp">

    <TextView
        android:id="@+id/title"
        style="@style/Heading20B"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/wallpaper_set_title"
        android:textColor="@color/tertiary_900"
        app:layout_constraintEnd_toStartOf="@id/btnClose"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/btnClose"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@android:color/transparent"
        android:padding="11dp"
        android:src="@drawable/ic_close"
        android:tint="@color/primary_500"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/subtitle"
        style="@style/Body14R"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/wallpaper_set_description"
        android:textColor="@color/tertiary_500"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/title" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnHome"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_width="0dp"
        android:layout_height="60dp"
        android:layout_marginTop="20dp"
        android:text="@string/wallpaper_set_home"
        android:textAppearance="@style/Button16S"
        android:textColor="@color/primary_500"
        app:backgroundTint="@color/neutral_0"
        app:cornerRadius="24dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/subtitle"
        app:rippleColor="@color/alpha_primary_10"
        app:strokeColor="@color/primary_200"
        app:strokeWidth="1dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnLock"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_width="0dp"
        android:layout_height="60dp"
        android:layout_marginTop="14dp"
        android:text="@string/wallpaper_set_lock"
        android:textAppearance="@style/Button16S"
        android:textColor="@color/primary_500"
        app:backgroundTint="@color/neutral_0"
        app:cornerRadius="24dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btnHome"
        app:rippleColor="@color/alpha_primary_10"
        app:strokeColor="@color/primary_200"
        app:strokeWidth="1dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnBoth"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_width="0dp"
        android:layout_height="60dp"
        android:layout_marginTop="14dp"
        android:text="@string/wallpaper_set_both"
        android:textAppearance="@style/Button16S"
        android:textColor="@color/neutral_0"
        app:backgroundTint="@color/primary_500"
        app:cornerRadius="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btnLock"
        app:rippleColor="@color/alpha_light_20"
        app:strokeWidth="0dp" />

</androidx.constraintlayout.widget.ConstraintLayout>

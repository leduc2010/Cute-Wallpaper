<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/artwork"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scaleType="centerCrop"
        app:layout_constraintDimensionRatio="H,89:156"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.HomeArtwork" />

    <ImageView
        android:id="@+id/playBadge"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@drawable/bg_home_heart"
        android:importantForAccessibility="no"
        android:padding="10dp"
        android:src="@drawable/ic_home_play"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/artwork"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/artwork" />

    <ImageView
        android:id="@+id/favoriteButton"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_margin="9dp"
        android:background="@drawable/bg_favorite_button"
        android:clickable="true"
        android:focusable="true"
        android:padding="9dp"
        android:src="@drawable/ic_home_heart_outline"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>

<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.chip.Chip xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Widget.MaterialComponents.Chip.Filter"
    android:layout_width="wrap_content"
    android:layout_height="36dp"
    android:minWidth="0dp"
    android:minHeight="0dp"
    android:textAppearance="@style/Body14R"
    android:textColor="@color/search_genre_chip_text"
    app:checkedIconVisible="false"
    app:chipBackgroundColor="@color/search_genre_chip_background"
    app:chipCornerRadius="18dp"
    app:chipEndPadding="11dp"
    app:chipIcon="@drawable/ic_search_genre_sparkle"
    app:chipIconSize="16dp"
    app:chipIconTint="@color/primary_500"
    app:chipIconVisible="true"
    app:chipMinHeight="36dp"
    app:chipStartPadding="9dp"
    app:chipStrokeColor="@color/search_genre_chip_stroke"
    app:chipStrokeWidth="1dp"
    app:ensureMinTouchTargetSize="false"
    app:iconEndPadding="5dp"
    app:iconStartPadding="0dp"
    app:rippleColor="@color/alpha_primary_10"
    app:textEndPadding="0dp"
    app:textStartPadding="0dp" />

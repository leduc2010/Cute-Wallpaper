<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/primary_50">
    <com.cute.wallpaper.ringtones.presentation.quotes.QuotePosterView
        android:id="@+id/poster"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />
    <ImageButton
        android:id="@+id/btnClose"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginTop="24dp"
        android:layout_marginEnd="24dp"
        android:padding="6dp"
        android:background="@drawable/bg_home_action"
        android:src="@drawable/ic_close"
        android:contentDescription="@string/quotes_close"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />
    <LinearLayout
        android:id="@+id/actions"
        android:layout_width="wrap_content"
        android:layout_height="64dp"
        android:layout_marginBottom="122dp"
        android:gravity="center"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        <ImageButton
            android:id="@+id/btnDownload"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:background="@drawable/bg_home_action"
            android:padding="16dp"
            android:src="@drawable/ic_download"
            android:tint="@color/primary_500"
            android:contentDescription="@string/quotes_download" />
        <ImageButton
            android:id="@+id/btnShare"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_marginStart="40dp"
            android:background="@drawable/bg_home_action"
            android:padding="16dp"
            android:src="@drawable/ic_share"
            android:tint="@color/primary_500"
            android:contentDescription="@string/quotes_share" />
    </LinearLayout>
    <ProgressBar
        android:id="@+id/exportProgress"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:indeterminateTint="@color/primary_500"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="@id/actions"
        app:layout_constraintBottom_toBottomOf="@id/actions"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>

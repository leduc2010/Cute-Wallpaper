<?xml version="1.0" encoding="utf-8"?>
<com.cute.wallpaper.ringtones.widget.SafeAreaView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/primary_50"
    android:clipChildren="false"
    android:clipToPadding="false">

    <ImageView
        android:id="@+id/btnBack"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_home_action"
        android:clickable="true"
        android:focusable="true"
        android:padding="5dp"
        android:src="@drawable/ic_back"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/wallpaperPager"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="18dp"
        android:layout_marginBottom="98dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:paddingHorizontal="28dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btnBack" />

    <ImageView
        android:id="@+id/btnFavorite"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:layout_marginStart="50dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_detail_secondary_action"
        android:clickable="true"
        android:elevation="3dp"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackgroundBorderless"
        android:padding="13dp"
        android:src="@drawable/ic_heart_outline"
        app:layout_constraintBottom_toBottomOf="@id/wallpaperPager"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/resultMessage"
        style="@style/Label12R"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:layout_marginBottom="18dp"
        android:background="@drawable/bg_detail_result_message"
        android:drawableStart="@drawable/ic_sparkles"
        android:drawablePadding="8dp"
        android:elevation="2dp"
        android:paddingHorizontal="16dp"
        android:gravity="center"
        android:maxLines="1"
        android:textColor="@color/tertiary_700"
        android:visibility="gone"
        app:drawableTint="@color/primary_500"
        app:layout_constraintBottom_toTopOf="@id/primaryActionContainer"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        tools:text="Wallpaper set on home screen"
        tools:visibility="visible" />

    <FrameLayout
        android:id="@+id/primaryActionContainer"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_marginBottom="11dp"
        android:background="@drawable/bg_wallpaper_action"
        android:elevation="3dp"
        app:layout_constraintBottom_toBottomOf="@id/wallpaperPager"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <ImageView
            android:id="@+id/btnPrimaryAction"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@android:color/transparent"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackgroundBorderless"
            android:padding="18dp"
            android:src="@drawable/ic_set_wallpaper" />

        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:id="@+id/actionProgress"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="center"
            android:indeterminate="true"
            android:visibility="gone"
            app:indicatorColor="@color/neutral_0"
            app:indicatorSize="32dp"
            app:trackColor="@android:color/transparent"
            app:trackThickness="2dp"
            tools:visibility="visible" />
    </FrameLayout>

    <ImageView
        android:id="@+id/btnInfo"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:layout_marginEnd="50dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_detail_secondary_action"
        android:clickable="true"
        android:elevation="3dp"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackgroundBorderless"
        android:padding="13dp"
        android:src="@drawable/ic_info"
        app:layout_constraintBottom_toBottomOf="@id/wallpaperPager"
        app:layout_constraintEnd_toEndOf="parent" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/actionMenu"
        android:layout_width="128dp"
        android:layout_height="56dp"
        android:layout_marginBottom="24dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/primaryActionContainer"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        tools:visibility="visible">

        <ImageView
            android:id="@+id/actionShare"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@drawable/bg_wallpaper_action"
            android:clickable="true"
            android:elevation="3dp"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackgroundBorderless"
            android:padding="16dp"
            android:src="@drawable/ic_share"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/actionSetLiveWallpaper"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginStart="72dp"
            android:background="@drawable/bg_wallpaper_action"
            android:clickable="true"
            android:elevation="3dp"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackgroundBorderless"
            android:padding="16dp"
            android:src="@drawable/ic_phone"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

</com.cute.wallpaper.ringtones.widget.SafeAreaView>

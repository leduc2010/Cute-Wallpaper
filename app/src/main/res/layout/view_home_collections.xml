<?xml version="1.0" encoding="utf-8"?>
<HorizontalScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/categoryScroll"
    android:layout_width="wrap_content"
    android:layout_height="54dp"
    android:layout_gravity="center_horizontal"
    android:layout_marginHorizontal="18dp"
    android:layout_marginTop="4dp"
    android:background="@drawable/bg_home_categories"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:overScrollMode="never"
    android:padding="5dp"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:animateLayoutChanges="true"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/categoryWallpaper"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_home_category_item"
            android:clickable="true"
            android:contentDescription="@string/home_wallpaper_category"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackgroundBorderless"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingEnd="6dp">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/categoryWallpaperImage"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:duplicateParentState="true"
                android:importantForAccessibility="no"
                android:scaleType="centerCrop"
                app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.CollectionIcon"
                app:strokeColor="@color/collection_icon_stroke"
                app:strokeWidth="2dp" />

            <TextView style="@style/Body14M"
                android:textColor="@color/tertiary_600"
                android:id="@+id/categoryWallpaperLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="6dp"
                android:singleLine="true"
                android:text="@string/home_wallpaper_category" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/categoryDualWallpapers"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_home_category_item"
            android:clickable="true"
            android:contentDescription="@string/home_dual_wallpapers_category"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackgroundBorderless"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingEnd="6dp">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/categoryDualWallpapersImage"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:duplicateParentState="true"
                android:importantForAccessibility="no"
                android:scaleType="centerCrop"
                app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.CollectionIcon"
                app:strokeColor="@color/collection_icon_stroke"
                app:strokeWidth="2dp" />

            <TextView style="@style/Body14M"
                android:textColor="@color/tertiary_600"
                android:id="@+id/categoryDualWallpapersLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="6dp"
                android:singleLine="true"
                android:text="@string/home_dual_wallpapers_category"
                android:visibility="gone" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/categoryBest"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="2dp"
            android:background="@drawable/bg_home_category_item"
            android:clickable="true"
            android:contentDescription="@string/home_best_category"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackgroundBorderless"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingEnd="6dp">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/categoryBestImage"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:duplicateParentState="true"
                android:importantForAccessibility="no"
                android:scaleType="centerCrop"
                app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.CollectionIcon"
                app:strokeColor="@color/collection_icon_stroke"
                app:strokeWidth="2dp" />

            <TextView style="@style/Body14M"
                android:textColor="@color/tertiary_600"
                android:id="@+id/categoryBestLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="6dp"
                android:singleLine="true"
                android:text="@string/home_best_category"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
</HorizontalScrollView>

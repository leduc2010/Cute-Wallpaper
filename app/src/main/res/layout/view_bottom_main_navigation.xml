<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="76dp"
    android:background="@drawable/bg_bottom_nav"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:elevation="12dp"
    android:paddingStart="12dp"
    android:paddingTop="18dp"
    android:paddingEnd="12dp"
    android:paddingBottom="14dp">

    <HorizontalScrollView
        android:id="@+id/navigationScroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/navigationItems"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:animateLayoutChanges="true"
            android:gravity="center"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/itemWallpapers"
                android:contentDescription="@string/wallpapers"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:background="@drawable/bg_bottom_nav_item"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:minWidth="44dp"
                android:orientation="horizontal"
                android:paddingHorizontal="10dp">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:duplicateParentState="true"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_nav_wallpaper" />

                <TextView
                    android:id="@+id/labelWallpapers"
                    style="@style/Label10B"
                    android:textColor="@color/bottom_nav_selected"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:singleLine="true"
                    android:text="@string/wallpapers" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/itemVideoWallpapers"
                android:contentDescription="@string/video_wallpapers"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:background="@drawable/bg_bottom_nav_item"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:minWidth="44dp"
                android:orientation="horizontal"
                android:paddingHorizontal="8dp">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:duplicateParentState="true"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_nav_video" />

                <TextView
                    android:id="@+id/labelVideoWallpapers"
                    style="@style/Label10B"
                    android:textColor="@color/bottom_nav_selected"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:singleLine="true"
                    android:text="@string/video_wallpapers"
                    android:visibility="gone" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/itemRingtones"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:background="@drawable/bg_bottom_nav_item"
                android:clickable="true"
                android:contentDescription="@string/ringtones"
                android:focusable="true"
                android:gravity="center"
                android:minWidth="44dp"
                android:orientation="horizontal"
                android:paddingHorizontal="8dp">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:duplicateParentState="true"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_nav_ringtone" />

                <TextView
                    android:id="@+id/labelRingtones"
                    style="@style/Label10B"
                    android:textColor="@color/bottom_nav_selected"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:singleLine="true"
                    android:text="@string/ringtones"
                    android:visibility="gone" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/itemProfilePictures"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:background="@drawable/bg_bottom_nav_item"
                android:clickable="true"
                android:contentDescription="@string/profile_pictures"
                android:focusable="true"
                android:gravity="center"
                android:minWidth="44dp"
                android:orientation="horizontal"
                android:paddingHorizontal="8dp">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:duplicateParentState="true"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_nav_profile" />

                <TextView
                    android:id="@+id/labelProfilePictures"
                    style="@style/Label10B"
                    android:textColor="@color/bottom_nav_selected"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:singleLine="true"
                    android:text="@string/profile_pictures"
                    android:visibility="gone" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/itemQuotes"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:background="@drawable/bg_bottom_nav_item"
                android:clickable="true"
                android:contentDescription="@string/quotes"
                android:focusable="true"
                android:gravity="center"
                android:minWidth="44dp"
                android:orientation="horizontal"
                android:paddingHorizontal="8dp">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:duplicateParentState="true"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_nav_quotes" />

                <TextView
                    android:id="@+id/labelQuotes"
                    style="@style/Label10B"
                    android:textColor="@color/bottom_nav_selected"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:singleLine="true"
                    android:text="@string/quotes"
                    android:visibility="gone" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/itemFavorites"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:background="@drawable/bg_bottom_nav_item"
                android:clickable="true"
                android:contentDescription="@string/favorites"
                android:focusable="true"
                android:gravity="center"
                android:minWidth="44dp"
                android:orientation="horizontal"
                android:paddingHorizontal="8dp">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:duplicateParentState="true"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_nav_favorite" />

                <TextView
                    android:id="@+id/labelFavorites"
                    style="@style/Label10B"
                    android:textColor="@color/bottom_nav_selected"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:singleLine="true"
                    android:text="@string/favorites"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>
    </HorizontalScrollView>
</FrameLayout>

<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="@color/neutral_0"
    app:cardCornerRadius="24dp"
    app:cardElevation="12dp">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="24dp"
            android:paddingEnd="24dp"
            android:paddingBottom="24dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/Button20B"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/auto_change_title"
                    android:textColor="@color/tertiary_900" />

                <TextView
                    style="@style/Heading18R"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="@string/auto_change_sparkle"
                    android:textColor="@color/warning_500" />
            </LinearLayout>

            <TextView
                android:id="@+id/downloadedCount"
                style="@style/Label12B"
                android:layout_width="match_parent"
                android:layout_height="32dp"
                android:layout_marginTop="24dp"
                android:background="@drawable/bg_auto_change_status"
                android:gravity="center"
                android:textColor="@color/primary_500" />

            <LinearLayout
                android:id="@+id/minimumBanner"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="24dp"
                android:background="@drawable/bg_auto_change_warning_banner"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="12dp">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_download"
                    app:tint="@color/tertiary_950" />

                <TextView
                    android:id="@+id/minimumHint"
                    style="@style/Label11R"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:textColor="@color/tertiary_800" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/applyToSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:orientation="vertical">

                <TextView
                    style="@style/Button14B"
                    android:layout_width="wrap_content"
                    android:layout_height="21dp"
                    android:gravity="center_vertical"
                    android:text="@string/auto_change_apply_to"
                    android:textColor="@color/tertiary_900" />

                <LinearLayout
                    android:id="@+id/optionHome"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_auto_change_target_option"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="14dp">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_phone"
                        app:tint="@color/tertiary_900" />

                    <TextView
                        style="@style/Button14S"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:duplicateParentState="true"
                        android:text="@string/auto_change_home_screen"
                        android:textColor="@color/auto_change_option_text" />

                    <ImageView
                        android:id="@+id/radioHome"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:contentDescription="@null"
                        android:duplicateParentState="true"
                        android:src="@drawable/auto_change_radio_state" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/optionLock"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_auto_change_target_option"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="14dp">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_lock"
                        app:tint="@color/tertiary_900" />

                    <TextView
                        style="@style/Button14S"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:duplicateParentState="true"
                        android:text="@string/auto_change_lock_screen"
                        android:textColor="@color/auto_change_option_text" />

                    <ImageView
                        android:id="@+id/radioLock"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:contentDescription="@null"
                        android:duplicateParentState="true"
                        android:src="@drawable/auto_change_radio_state" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/optionBoth"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_auto_change_target_option"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="14dp">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_phone_lock"
                        app:tint="@color/tertiary_900" />

                    <TextView
                        style="@style/Button14S"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:duplicateParentState="true"
                        android:text="@string/auto_change_both_screens"
                        android:textColor="@color/auto_change_option_text" />

                    <ImageView
                        android:id="@+id/radioBoth"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:contentDescription="@null"
                        android:duplicateParentState="true"
                        android:src="@drawable/auto_change_radio_state" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/frequencySection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/option3Hours"
                        style="@style/Label12B"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_auto_change_frequency_option"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:text="@string/auto_change_every_3_hours"
                        android:textColor="@color/auto_change_option_text" />

                    <Space
                        android:layout_width="12dp"
                        android:layout_height="1dp" />

                    <TextView
                        android:id="@+id/option6Hours"
                        style="@style/Label12B"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_auto_change_frequency_option"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:text="@string/auto_change_every_6_hours"
                        android:textColor="@color/auto_change_option_text" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/option12Hours"
                        style="@style/Label12B"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_auto_change_frequency_option"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:text="@string/auto_change_every_12_hours"
                        android:textColor="@color/auto_change_option_text" />

                    <Space
                        android:layout_width="12dp"
                        android:layout_height="1dp" />

                    <TextView
                        android:id="@+id/option24Hours"
                        style="@style/Label12B"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_auto_change_frequency_option"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:text="@string/auto_change_every_24_hours"
                        android:textColor="@color/auto_change_option_text" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/btnEnable"
                style="@style/Button16S"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="32dp"
                android:background="@drawable/bg_button_primary"
                android:gravity="center"
                android:text="@string/auto_change_enable"
                android:textColor="@color/neutral_0" />

            <TextView
                android:id="@+id/btnSaveChanges"
                style="@style/Button16S"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="32dp"
                android:background="@drawable/bg_button_primary"
                android:gravity="center"
                android:text="@string/auto_change_save_changes"
                android:textColor="@color/neutral_0"
                android:visibility="gone" />

            <TextView
                android:id="@+id/btnStop"
                style="@style/Button16S"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_auto_change_stop"
                android:gravity="center"
                android:text="@string/auto_change_stop"
                android:textColor="@color/primary_500"
                android:visibility="gone" />
        </LinearLayout>

        <ImageView
            android:id="@+id/btnClose"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="top|end"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="16dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/close"
            android:src="@drawable/ic_close" />
    </FrameLayout>
</com.google.android.material.card.MaterialCardView>

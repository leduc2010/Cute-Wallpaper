<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true"
    android:background="@drawable/bg_auto_change_dialog"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="24dp"
        android:paddingEnd="24dp"
        android:paddingBottom="24dp">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="48dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:gravity="center"
                android:text="@string/auto_change_title"
                android:textColor="@color/tertiary_900"
                android:textAppearance="@style/Heading20B" />

            <ImageView
                android:id="@+id/btnClose"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="end|center_vertical"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/close"
                android:padding="12dp"
                android:src="@drawable/ic_close" />
        </FrameLayout>

        <TextView
            android:id="@+id/downloadedCount"
            style="@style/Body14S"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_home_header_action"
            android:paddingHorizontal="16dp"
            android:paddingVertical="8dp"
            android:textColor="@color/tertiary_700" />

        <TextView
            android:id="@+id/minimumHint"
            style="@style/Label12R"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:textColor="@color/tertiary_500" />

        <TextView
            style="@style/Body14S"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/auto_change_apply_to"
            android:textColor="@color/tertiary_900" />

        <TextView
            android:id="@+id/optionHome"
            style="@style/Body16S"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_auto_change_option"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:paddingHorizontal="20dp"
            android:text="@string/auto_change_home_screen"
            android:textColor="@color/auto_change_option_text" />

        <TextView
            android:id="@+id/optionLock"
            style="@style/Body16S"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_auto_change_option"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:paddingHorizontal="20dp"
            android:text="@string/auto_change_lock_screen"
            android:textColor="@color/auto_change_option_text" />

        <TextView
            android:id="@+id/optionBoth"
            style="@style/Body16S"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_auto_change_option"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:paddingHorizontal="20dp"
            android:text="@string/auto_change_both_screens"
            android:textColor="@color/auto_change_option_text" />

        <TextView
            style="@style/Body14S"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/auto_change_frequency"
            android:textColor="@color/tertiary_900" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/option3Hours"
                style="@style/Body14S"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:background="@drawable/bg_auto_change_option"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="@string/auto_change_every_3_hours"
                android:textColor="@color/auto_change_option_text" />

            <Space
                android:layout_width="8dp"
                android:layout_height="1dp" />

            <TextView
                android:id="@+id/option6Hours"
                style="@style/Body14S"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:background="@drawable/bg_auto_change_option"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="@string/auto_change_every_6_hours"
                android:textColor="@color/auto_change_option_text" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/option12Hours"
                style="@style/Body14S"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:background="@drawable/bg_auto_change_option"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="@string/auto_change_every_12_hours"
                android:textColor="@color/auto_change_option_text" />

            <Space
                android:layout_width="8dp"
                android:layout_height="1dp" />

            <TextView
                android:id="@+id/option24Hours"
                style="@style/Body14S"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:background="@drawable/bg_auto_change_option"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="@string/auto_change_every_24_hours"
                android:textColor="@color/auto_change_option_text" />
        </LinearLayout>

        <TextView
            android:id="@+id/btnEnable"
            style="@style/Body16S"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_detail_primary_action"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="@string/auto_change_enable"
            android:textColor="@color/neutral_0" />

        <TextView
            android:id="@+id/btnSaveChanges"
            style="@style/Body16S"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_detail_primary_action"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="@string/auto_change_save_changes"
            android:textColor="@color/neutral_0"
            android:visibility="gone" />

        <TextView
            android:id="@+id/btnStop"
            style="@style/Body16S"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_auto_change_stop"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="@string/auto_change_stop"
            android:textColor="@color/primary_500"
            android:visibility="gone" />
    </LinearLayout>
</ScrollView>

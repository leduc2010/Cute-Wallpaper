<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/primary_50"
    android:focusableInTouchMode="true">
    <LinearLayout
        android:id="@+id/quoteTabs"
        android:layout_width="wrap_content"
        android:layout_height="54dp"
        android:layout_marginTop="8dp"
        android:paddingHorizontal="12dp"
        android:paddingVertical="8dp"
        android:gravity="center_vertical"
        android:background="@drawable/quotes_tabs_background"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        <TextView
            android:id="@+id/tabNew"
            style="@style/Body14M"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:minWidth="40dp"
            android:gravity="center"
            android:paddingHorizontal="12dp"
            android:background="@drawable/quotes_tab_background"
            android:textColor="@color/tertiary_600"
            android:contentDescription="@string/quotes_new" />
        <TextView
            android:id="@+id/tabPopular"
            style="@style/Body14M"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:minWidth="40dp"
            android:layout_marginStart="12dp"
            android:gravity="center"
            android:paddingHorizontal="12dp"
            android:background="@drawable/quotes_tab_background"
            android:textColor="@color/tertiary_600"
            android:contentDescription="@string/quotes_popular" />
        <TextView
            android:id="@+id/tabCategories"
            style="@style/Body14M"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:minWidth="40dp"
            android:layout_marginStart="12dp"
            android:gravity="center"
            android:paddingHorizontal="12dp"
            android:background="@drawable/quotes_tab_background"
            android:textColor="@color/tertiary_600"
            android:contentDescription="@string/quotes_categories" />
    </LinearLayout>
    <EditText
        android:id="@+id/etSearch"
        style="@style/Label12R"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginHorizontal="18dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_home_search"
        android:backgroundTint="@null"
        android:drawableStart="@drawable/ic_search"
        android:drawablePadding="4dp"
        android:hint="@string/search_quotes"
        android:imeOptions="actionSearch"
        android:importantForAutofill="no"
        android:inputType="text"
        android:paddingHorizontal="12dp"
        android:singleLine="true"
        android:textColor="@color/tertiary_900"
        android:textColorHint="@color/tertiary_300"
        app:layout_constraintTop_toBottomOf="@id/quoteTabs"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />
    <TextView
        android:id="@+id/btnCategoryBrowser"
        style="@style/Label10B"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:layout_marginEnd="32dp"
        android:gravity="center"
        android:text="@string/quotes_categories"
        android:textColor="@color/primary_500"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="@id/etSearch"
        app:layout_constraintBottom_toBottomOf="@id/etSearch"
        app:layout_constraintEnd_toEndOf="parent" />
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvContent"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:paddingHorizontal="20dp"
        android:paddingTop="16dp"
        android:clipToPadding="false"
        android:overScrollMode="never"
        app:layout_constraintTop_toBottomOf="@id/etSearch"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>

<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="260dp"
    app:cardBackgroundColor="@android:color/transparent"
    app:cardCornerRadius="24dp"
    app:cardElevation="0dp"
    app:strokeWidth="0dp">
    <ImageView
        android:id="@+id/thumbnail"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop" />
    <View
        android:id="@+id/thumbnailOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/alpha_light_80" />
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cardContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingHorizontal="16dp"
        android:paddingBottom="16dp">
        <TextView
            android:id="@+id/featuredBadge"
            style="@style/Label10B"
            android:layout_width="wrap_content"
            android:layout_height="24dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/profile_feed_badge"
            android:backgroundTint="@color/neutral_0"
            android:gravity="center"
            android:paddingHorizontal="8dp"
            android:text="@string/quotes_featured"
            android:textColor="@color/primary_500"
            android:visibility="gone"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent" />
        <TextView
            android:id="@+id/quoteMark"
            style="@style/Heading28B"
            android:layout_width="wrap_content"
            android:layout_height="24dp"
            android:layout_marginTop="28dp"
            android:gravity="center"
            android:text="@string/quotes_mark"
            android:textColor="@color/primary_500"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />
        <TextView
            android:id="@+id/quoteText"
            style="@style/Body14S"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="8dp"
            android:gravity="top|center_horizontal"
            android:ellipsize="end"
            android:maxLines="7"
            android:lineSpacingExtra="0dp"
            android:textColor="@color/tertiary_900"
            app:layout_constraintTop_toBottomOf="@id/quoteMark"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toTopOf="@id/separator" />
        <LinearLayout
            android:id="@+id/actions"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:gravity="center"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">
            <ImageButton
                android:id="@+id/btnFavorite"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/quotes_favorite_background"
                android:padding="8dp"
                android:src="@drawable/ic_favorite"
                android:tint="@color/quotes_favorite_tint" />
            <ImageButton
                android:id="@+id/btnPreview"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_home_action"
                android:padding="8dp"
                android:src="@drawable/ic_quote_preview"
                android:contentDescription="@string/quotes_preview" />
            <ImageButton
                android:id="@+id/btnCopy"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_home_action"
                android:padding="8dp"
                android:src="@drawable/ic_copy"
                android:contentDescription="@string/quotes_copy" />
            <ImageButton
                android:id="@+id/btnShare"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_home_action"
                android:padding="8dp"
                android:src="@drawable/ic_share"
                android:tint="@color/primary_500"
                android:contentDescription="@string/quotes_share" />
        </LinearLayout>
        <ImageView
            android:id="@+id/separator"
            android:layout_width="36dp"
            android:layout_height="12dp"
            android:layout_marginTop="8dp"
            android:src="@drawable/ic_quote_attribution_separator"
            android:visibility="gone"
            android:importantForAccessibility="no"
            app:layout_constraintTop_toBottomOf="@id/quoteText"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />
        <TextView
            android:id="@+id/attribution"
            style="@style/Label11B"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:text="@string/quotes_unknown_author"
            android:textColor="@color/neutral_500"
            android:visibility="gone"
            app:layout_constraintTop_toBottomOf="@id/separator"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>

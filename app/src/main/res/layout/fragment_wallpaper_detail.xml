<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/primary_50"
    android:clipChildren="false"
    android:clipToPadding="false">

    <ImageView
        android:id="@+id/btnBack"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_home_action"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackgroundBorderless"
        android:padding="14dp"
        android:src="@drawable/ic_search_back"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/wallpaperPager"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="18dp"
        android:layout_marginBottom="98dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:paddingHorizontal="28dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btnBack" />

    <ImageView
        android:id="@+id/btnFavorite"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="48dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_detail_secondary_action"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackgroundBorderless"
        android:padding="11dp"
        android:src="@drawable/ic_home_heart_outline"
        app:layout_constraintBottom_toBottomOf="@id/wallpaperPager"
        app:layout_constraintStart_toStartOf="parent" />

    <FrameLayout
        android:id="@+id/primaryActionContainer"
        android:layout_width="58dp"
        android:layout_height="58dp"
        android:layout_marginBottom="11dp"
        app:layout_constraintBottom_toBottomOf="@id/wallpaperPager"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <ImageView
            android:id="@+id/btnPrimaryAction"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_detail_primary_action"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackgroundBorderless"
            android:padding="17dp"
            android:src="@drawable/ic_detail_magic" />

        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:id="@+id/actionProgress"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="center"
            android:visibility="gone"
            app:indicatorColor="@color/neutral_0"
            app:indicatorSize="32dp"
            app:trackColor="@android:color/transparent"
            app:trackThickness="2dp"
            tools:visibility="visible" />
    </FrameLayout>

    <ImageView
        android:id="@+id/btnInfo"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginEnd="48dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_detail_secondary_action"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackgroundBorderless"
        android:padding="11dp"
        android:src="@drawable/ic_detail_info"
        app:layout_constraintBottom_toBottomOf="@id/wallpaperPager"
        app:layout_constraintEnd_toEndOf="parent" />

    <GridLayout
        android:id="@+id/actionMenu"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:columnCount="3"
        android:orientation="horizontal"
        android:rowCount="1"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/primaryActionContainer"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        tools:visibility="visible">

        <ImageView
            android:id="@+id/actionSetWallpaper"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_margin="5dp"
            android:background="@drawable/bg_detail_primary_action"
            android:clickable="true"
            android:contentDescription="@string/wallpaper_action_set"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackgroundBorderless"
            android:padding="12dp"
            android:src="@drawable/ic_detail_phone" />


        <ImageView
            android:id="@+id/actionDownload"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_margin="5dp"
            android:background="@drawable/bg_detail_primary_action"
            android:clickable="true"
            android:contentDescription="@string/wallpaper_action_download"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackgroundBorderless"
            android:padding="12dp"
            android:src="@drawable/ic_detail_download" />

        <ImageView
            android:id="@+id/actionShare"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_margin="5dp"
            android:background="@drawable/bg_detail_primary_action"
            android:clickable="true"
            android:contentDescription="@string/wallpaper_action_share"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackgroundBorderless"
            android:padding="12dp"
            android:src="@drawable/ic_detail_share" />

    </GridLayout>

</androidx.constraintlayout.widget.ConstraintLayout>

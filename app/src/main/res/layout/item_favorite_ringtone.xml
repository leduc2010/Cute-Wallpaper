<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="64dp"
    android:background="@drawable/bg_favorites_ringtone"
    android:paddingHorizontal="12dp">
    <FrameLayout
        android:id="@+id/playContainer"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:background="@drawable/bg_home_action"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">
        <ImageButton
            android:id="@+id/playButton"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@android:color/transparent"
            android:padding="8dp"
            android:src="@drawable/ic_play"
            android:contentDescription="@string/ringtone_action_play" />
        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:id="@+id/playLoading"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center"
            android:visibility="gone"
            app:indicatorSize="24dp"
            app:indicatorColor="@color/primary_500"
            app:trackThickness="2dp" />
    </FrameLayout>
    <TextView
        android:id="@+id/contentTitle"
        style="@style/Label12B"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="8dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/tertiary_50"
        app:layout_constraintStart_toEndOf="@id/playContainer"
        app:layout_constraintEnd_toStartOf="@id/favoriteButton"
        app:layout_constraintTop_toTopOf="@id/playContainer" />
    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/playProgress"
        android:layout_width="0dp"
        android:layout_height="4dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="8dp"
        android:max="100"
        app:trackColor="@color/primary_200"
        app:indicatorColor="@color/primary_500"
        app:trackThickness="4dp"
        app:trackCornerRadius="2dp"
        app:layout_constraintStart_toEndOf="@id/playContainer"
        app:layout_constraintEnd_toStartOf="@id/favoriteButton"
        app:layout_constraintBottom_toBottomOf="@id/playContainer" />
    <ImageButton
        android:id="@+id/favoriteButton"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginEnd="6dp"
        android:background="@drawable/quotes_favorite_background"
        android:padding="8dp"
        android:src="@drawable/ic_heart_filled"
        android:tint="@color/quotes_favorite_tint"
        android:contentDescription="@string/favorites"
        app:layout_constraintEnd_toStartOf="@id/setButton"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />
    <ImageButton
        android:id="@+id/setButton"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:background="@drawable/bg_favorite_button"
        android:padding="8dp"
        android:src="@drawable/ic_phone"
        android:tint="@color/primary_500"
        android:contentDescription="@string/ringtone_action_set"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>

<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="64dp"
    android:background="@drawable/bg_favorites_ringtone"
    android:paddingHorizontal="12dp">
    <FrameLayout
        android:id="@+id/playContainer"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:background="@drawable/bg_ringtone_play_state"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">
        <ImageView
            android:id="@+id/playButton"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:duplicateParentState="true"
            android:padding="8dp"
            android:src="@drawable/ic_ringtone_play_state" />
        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:id="@+id/playLoading"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center"
            android:visibility="gone"
            app:indicatorSize="24dp"
            app:indicatorColor="@color/primary_500"
            app:trackThickness="2dp" />
    </FrameLayout>
    <TextView
        android:id="@+id/contentTitle"
        style="@style/Label12B"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="8dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/tertiary_50"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/newBadge"
        app:layout_constraintStart_toEndOf="@id/playContainer"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/newBadge"
        style="@style/Label10B"
        android:layout_width="wrap_content"
        android:layout_height="14dp"
        android:layout_marginEnd="8dp"
        android:gravity="center_vertical"
        android:maxLines="1"
        android:text="@string/ringtone_new"
        android:textColor="@color/primary_700"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/favoriteButton"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/favoriteButton"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:scaleType="fitXY"
        android:layout_marginEnd="6dp"
        android:src="@drawable/ic_favorite_featured_light_action"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/setButton"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/setButton"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:scaleType="fitXY"
        android:src="@drawable/ic_add_folder_favorite_action"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>

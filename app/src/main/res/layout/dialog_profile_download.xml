<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/profile_editor_download_background"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:elevation="12dp"
    android:outlineProvider="background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="60dp"
        android:paddingEnd="20dp"
        android:paddingBottom="20dp">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="114dp"
            app:cardBackgroundColor="@color/neutral_0"
            app:cardCornerRadius="24dp"
            app:cardElevation="4dp"
            app:cardPreventCornerOverlap="false"
            app:cardUseCompatPadding="false"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp">

                <com.cute.wallpaper.ringtones.presentation.profile.ProfilePhotoView
                    android:id="@+id/preview"
                    android:layout_width="82dp"
                    android:layout_height="82dp"
                    android:background="@drawable/bg_profile_download_avatar_ring"
                    android:importantForAccessibility="no"
                    android:padding="4dp"
                    app:profileDrawSparkles="false"
                    app:profileThumbnailCornerRadius="37dp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="27dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            style="@style/Heading18B"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/profile_download_username"
                            android:textColor="@color/neutral_700" />

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_marginStart="6dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_profile_verified" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="30dp"
                        android:layout_marginTop="12dp"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="30dp"
                            android:layout_weight="1"
                            android:background="@drawable/profile_download_stat_background"
                            android:fontFamily="@font/poppins_bold"
                            android:gravity="center"
                            android:text="@string/profile_download_followers"
                            android:textColor="@color/neutral_700"
                            android:textSize="13sp" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="30dp"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:background="@drawable/profile_download_stat_background"
                            android:fontFamily="@font/poppins_bold"
                            android:gravity="center"
                            android:text="@string/profile_download_likes"
                            android:textColor="@color/neutral_700"
                            android:textSize="13sp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            style="@style/Body14M"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:lineHeight="20dp"
            android:text="@string/profile_editor_save_description"
            android:textColor="@color/neutral_700" />

        <FrameLayout
            android:id="@+id/downloadAction"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_button_primary"
            android:clickable="true"
            android:focusable="true"
            android:stateListAnimator="@animator/enabled_alpha_50">

            <TextView
                android:id="@+id/downloadLabel"
                style="@style/Button16S"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:drawableStart="@drawable/ic_download"
                android:drawablePadding="6dp"
                android:gravity="center"
                android:text="@string/profile_editor_download_image"
                android:textColor="@color/neutral_0" />

            <ProgressBar
                android:id="@+id/progress"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>

    <ImageView
        android:id="@+id/close"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="top|end"
        android:layout_margin="4dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:padding="12dp"
        android:src="@drawable/ic_close" />
</FrameLayout>

<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <layer-list>
            <item>
                <shape android:shape="oval">
                    <solid android:color="@color/secondary_600" />
                    <stroke android:width="3dp" android:color="@color/primary_500" />
                </shape>
            </item>
            <item android:left="12dp" android:top="12dp" android:right="12dp" android:bottom="12dp"
                android:drawable="@drawable/ic_frame" />
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item><shape android:shape="oval"><solid android:color="@color/secondary_600" /></shape></item>
            <item android:left="12dp" android:top="12dp" android:right="12dp" android:bottom="12dp"
                android:drawable="@drawable/ic_frame" />
        </layer-list>
    </item>
</selector>

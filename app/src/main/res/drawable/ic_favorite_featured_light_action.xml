<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true" android:drawable="@drawable/ic_favorite_selected" />
    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/alpha_light_80" />
                    <stroke android:width="1dp" android:color="@color/neutral_0" />
                    <corners android:radius="16dp" />
                </shape>
            </item>
            <item android:left="8dp" android:top="8dp" android:right="8dp" android:bottom="8dp"
                android:drawable="@drawable/ic_heart_outline" />
        </layer-list>
    </item>
</selector>
